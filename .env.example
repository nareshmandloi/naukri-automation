# Copy to .env for local runs. NEVER commit .env.
# In GitHub Actions these come from repository Secrets instead.
NAUKRI_EMAIL=you@example.com
NAUKRI_PASSWORD=your-naukri-password

# Optional overrides
# HEADLESS=false      # watch the browser (local debugging only)
# DRY_RUN=true        # do everything except the actual upload

# Auto-apply (npm run apply) — all optional
# SEARCH_KEYWORDS=Full Stack Developer, GenAI Engineer, Node.js Developer, React Developer
# JOB_LOCATIONS=pune,bangalore      # empty = anywhere
# MAX_APPLICATIONS=4                # per run; 12 runs/day x 4 stays under Naukri's daily cap
# MIN_MATCHED_SKILLS=3              # job tags that must appear in the resume
# MIN_MATCH_RATIO=0.4               # share of a job's tags found in the resume
# YEARS_EXPERIENCE=6                # default: read from the resume summary
# STOP_AFTER_QUESTIONNAIRE=true     # debug: stop at the first job that asks questions
# Screening-question answers are read from candidate.json (gitignored); see README.
